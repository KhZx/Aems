# ═══════════════════════════════════════════════════════════════
#  AEMS — Backend Environment Variables
#  Copy this file to `.env` and fill in real values.
#  NEVER commit `.env` to Git.
# ═══════════════════════════════════════════════════════════════

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aems?schema=public

# ── Firebase Admin SDK ────────────────────────────────────────
# From Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=aems-a100
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@aems-a100.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production this MUST be your hosted frontend origin (e.g. https://aems.example.com)
FRONTEND_ORIGIN=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── First-time admin bootstrap ────────────────────────────────
# If set, a user with this Firebase UID is created/kept as an ACTIVE ADMIN.
# This is the ONLY supported way to bootstrap the first administrator.
BOOTSTRAP_ADMIN_UID=
