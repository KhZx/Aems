# Normalize line endings: store LF in the repo (Railway builds on Linux).
* text=auto
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.sh text eol=lf

# Never touch binaries
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.webp binary
