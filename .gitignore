# ═══════════════════════════════════════════════════════════════
#  AEMS — Git ignore
#  Source code only. Secrets and build artifacts never reach GitHub.
# ═══════════════════════════════════════════════════════════════

# ── Secrets (NEVER commit) ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
firebase-adminsdk*.json

# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Testing / coverage ────────────────────────────────────────
coverage/
.tmp/

# ── Deploy tooling / local overrides ──────────────────────────
.vercel/
*.local

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# ── Stray Explorer/OneDrive copies ────────────────────────────
* - Copy*
