{
  "id": "/",
  "name": "AEMS — Ambulance Equipment Management System",
  "short_name": "AEMS",
  "description": "Dubai Corporation of Ambulance Services — real-time equipment tracking, expiry alerts, duty calendar and shift handovers for every DCAS station.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#06080F",
  "theme_color": "#06080F",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "medical", "business"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
